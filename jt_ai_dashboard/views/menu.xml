<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <!-- Client Action -->
        <record id="action_ai_dashboard" model="ir.actions.client">
            <field name="name">AI Dashboard</field>
            <field name="tag">ai_dashboard</field> <!-- Must match your JS registry key -->
        </record>

        <!-- Dashboard Menu -->
        <menuitem id="menu_ai_dashboard"
                  name="Dashboard"
                  parent="menu_ai_prompt_root"
                  action="action_ai_dashboard"
                  sequence="1"/>
    </data>
</odoo>
