<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_ai_prompt_tree" model="ir.ui.view">
        <field name="name">groq.prompt.tree</field>
        <field name="model">groq.prompt</field>
        <field name="type">tree</field>  
        <field name="arch" type="xml">
            <tree string="JT AI Prompts">
                <field name="name"/>
                <field name="response"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_ai_prompt_form" model="ir.ui.view">
        <field name="name">groq.prompt.form</field>
        <field name="model">groq.prompt</field>
        <field name="type">form</field>  
        <field name="arch" type="xml">
            <form string="JT AI Prompt">
                <sheet>
                    <group>
                        <field name="name" placeholder="Type your question about Odoo modules"/>
                        <field name="response" readonly="1"/>
                    </group>
                    <footer>
                        <button type="object" name="action_ask_ai" string="Ask JT AI" class="btn btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_ai_prompt" model="ir.actions.act_window">
        <field name="name">JT AI Prompt</field>
        <field name="res_model">groq.prompt</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_ai_prompt_root" name="JT AI" sequence="1"/>
    <menuitem id="menu_ai_prompt"
              parent="menu_ai_prompt_root"
              name="Ask JT AI"
              action="action_ai_prompt"
              sequence="10"
              active="False"
              />
</odoo>
