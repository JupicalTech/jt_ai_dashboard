<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="jt_ai_dashboard.ai_dashboard" owl="1">
    <section t-attf-class="jt_ai_dashboard_container container #{state.showSidebar ? 'sidebar-open' : 'sidebar-closed'}">
      <!-- Ask Question Input -->
      <div class="input-overlap-container">
        <input type="text"
               t-model="state.question"
               placeholder="Ask Me Anything..."
               class="form-control my-square-input"
               t-on-keypress="onKeyPress"/>
        <button t-on-click="askQuestion"
                class="btn btn-primary btn-circle overlap-btn">
          <i class="fa fa-arrow-up"/>
        </button>
      </div>

      <!-- Floating Sidebar Toggle Button -->
      <div class="sidebar-floating-toggle" t-on-click="toggleSidebar">
        <i class="fa" t-att-class="state.showSidebar ? 'fa-angle-left' : 'fa-angle-right'" />
      </div>

      <!-- Sidebar Component -->
      <PromptHistorySidebar
        showSidebar="state.showSidebar"
        onToggleSidebar.bind="toggleSidebar"
      />

      <!-- AI Response Table -->
      <div class="jt-main-content">
      <div t-if="state.response.length" class="oe_response">
        <h4>Response:</h4>
        <div style="max-height: 300px; overflow-y: auto; border: 1px solid #ddd;">
          <table class="table table-striped">
            <tbody>
              <t t-foreach="state.response" t-as="row" t-key="row_index">
                <tr>
                  <t t-foreach="row" t-as="cell" t-key="cell_index">
                    <td t-esc="cell"/>
                  </t>
                </tr>
              </t>
            </tbody>
          </table>
        </div>
      </div>
      </div>

      <!-- Chart Display -->
      <!-- <div style="margin-left:340px;"> -->
      <div class="jt-main-content">
      <div t-if="state.chartData" class="chart-container mt-4">
        <h4>Graphical Representation:</h4>
        <table width="100%">
          <tr>
            <td width="50%" align="center">
              <canvas t-ref="chartCanvas"></canvas>
            </td>
            <td width="50%" align="center">
              <canvas t-ref="linechartCanvas"></canvas>
            </td>
          </tr>
        </table>
      </div>
    </div>

    </section>
  </t>
</templates>
